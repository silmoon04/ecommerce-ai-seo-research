  "definitions": {
    "purchase": "Completed non-test order reaching the declared paid-purchase state; payment authorizations or checkout creation alone do not count. Refunded and cancelled outcomes are reconciled separately.",
    "retainedOrders": "Orders meeting the declared retained-order rule after outcome maturation; distinct from completed orders.",
    "retainedContribution": "Order-ledger sales net of discounts and applicable sales taxes, less net cost of goods, fees, fulfillment, shipping subsidy, refunds, cancellations, reverse logistics and nonrecoverable return loss, with recovered goods credited consistently.",
    "contributionUnit": "Expected retained contribution per completed order, including the effect of returns; not contribution conditional on keeping an order.",
    "causalEconomicEstimand": "For a population fixed before treatment, E[Y(1)-Y(0)] where Y is total retained contribution over the fixed horizon, including zero-purchase users.",
    "attribution": "Credit assigned to a recorded origin; does not identify the counterfactual without the intervention.",
    "threeTimesHurdle": "Benefits / all incremental customer costs >= 3, equivalent to 200 percent net ROI.",
    "literalThreeHundredPercentNetROI": "(Benefits - costs) / costs >= 3, requiring benefits / costs >= 4."
  },
  "formulas": {
    "eligibleVisits": "N * e",
    "incrementalCompletedOrders": "N * e * (p1 - p0)",
    "incrementalRetainedContribution": "N * e * (p1*c1 - p0*c0)",
    "merchantNetValue": "incrementalRetainedContribution + L - K - P",
    "constantContributionScenario": "N * e * p0 * relativeLift * c",
    "breakEvenRelativeLift": "(P + K - L) / (N * e * p0 * c)",
    "feeCeilingAt3xValueToCost": "max(0, (incrementalRetainedContribution + L)/3 - K)",
    "feeCeilingAt300PercentNetROI": "max(0, (incrementalRetainedContribution + L)/4 - K)",
    "relativeLiftAt3xValueToCost": "(3*(P+K)-L) / (N*e*p0*c)",
    "laborValue": "verifiedHoursAvoided * fullyLoadedHourlyCost * avoidableOrUsefulRedeploymentFraction - newReviewCostNotAlreadyInK",
    "trafficAndConversionOrderLift": "(1 + relativeTrafficLift) * (1 + relativeConditionalConversionLift) - 1",
    "equalClusterDesignEffect": "1 + (meanClusterSize - 1) * ICC"
  },
  "formulaValidity": [
    "N, e, p0 and c must be valid nonnegative inputs; break-even ratios are undefined when the denominator is zero or nonpositive.",
